{{! Gear Tab }}
<section class='tab gear scrollable {{tab.cssClass}}' data-group='primary' data-tab='gear'>
  <label class="title">{{{localize "INVINCIBLE.Actor.Tabs.Gear"}}}</label>
  <div class="resources">
    {{formGroup systemFields.resources value=system.resources}}
  </div>
  <div class="separator"></div>
  {{#each gear as | gear index |}}
  <div class="gear-info" data-document-class="Item" data-item-id="{{gear.id}}">
    <label class="rollable" data-action="roll" data-roll-type="automation">
      {{gear.name}}{{addActiveSign gear.system.active}}
    </label>
    {{gear.system.extraInfo}}
    {{{gear.enriched}}}
  </div>
  {{/each}}
</section>