<section class='tab powers scrollable {{tab.cssClass}}' data-group='primary' data-tab='powers'>
  <label class="title">{{{localize "INVINCIBLE.Actor.Tabs.Powers"}}}</label>
  {{#each powers as | ps index |}}
  <div class="powers-info">
    <label class="rollable" data-action="roll" data-roll-type="automation" data-document-class="Item"
      data-item-id="{{ps.powerSource.id}}">
      {{ps.powerSource.name}}
    </label>
    <div class="item-description">
      {{{ps.powerSource.enriched}}}
    </div>
    {{#each ps.powers as | power |}}
    <ul>
      <li data-document-class="Item" data-item-id="{{power.id}}">
        <label class="rollable" data-action="roll"
          data-roll-type="automation">{{power.system.powerLevel}}{{power.name}}</label>
        <div class="item-description">
          {{{power.enriched}}}
        </div>
        {{#if (lookup ../../boosts power.id)}}
        <div style="height: 15px;"></div>
        {{/if}}
        {{#each (lookup ../../boosts power.id) as | boost |}}
        <div class="boostLimit">
          <img src="{{boost.img}}">
          <strong>{{boost.name}}</strong>
          <div class="item-description">
            {{{boost.system.description}}}
          </div>
        </div>
        {{/each}}
        {{#each (lookup ../../limits power.id) as | limit |}}
        <div class="boostLimit">
          <img src="{{limit.img}}">
          <strong>{{limit.name}}</strong>
          <div class="item-description">
            {{{limit.system.description}}}
          </div>
        </div>
        {{/each}}
      </li>
    </ul>
    {{/each}}
  </div>
  {{/each}}
</section>