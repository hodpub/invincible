<section class='tab scrollable automations {{tab.cssClass}}' data-group='primary' data-tab='automations'>
  <div class="form-group">
    <label>
      <a class='automation-create' data-action='createAutomation' data-origin="{{@root.item.uuid}}">
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='Automation'}}
      </a>
    </label>
  </div>
  {{#each automations as | automation |}}
  <details data-automation-id="{{automation._id}}" {{#if automation.open}}open{{/if}}>
    <summary>
      {{automation.name}}
    </summary>
    <div class="form-group">
      <label>{{localize "INVINCIBLE.Automation.Type.label"}}</label>
      <div class="form-fields">
        <input type="text" disabled value="{{ localize (concat "INVINCIBLE.Automation.Type." automation.type) }}">
      </div>
    </div>
    <div class="form-group">
      <label for="system.automations.{{automation._id}}.name">{{localize "Name"}}</label>
      <div class="form-fields">
        <input type="text" name="system.automations.{{automation._id}}.name" value="{{automation.name}}">
      </div>
    </div>
    {{#if automation.schema.fields.showAsSelection}}
    <div class="form-group">
      <label for="system.automations.{{automation._id}}.showAsSelection">{{localize
        "INVINCIBLE.Automation.FIELDS.showAsSelection.label"}}</label>
      <input type="checkbox" name="system.automations.{{automation._id}}.showAsSelection" {{checked
        automation.showAsSelection}} />
    </div>
    {{/if}}
    {{> (concat "systems/invincible/templates/item/automation-parts/" automation.type ".hbs") automation=automation
    key=automation._id}}

    <a class='delete' data-action='deleteAutomation' data-tooltip='{{localize "DOCUMENT.Delete" type='Automation'}}'>
      {{localize 'DOCUMENT.Delete' type='Automation'}}
      <i class='fas fa-trash'></i>
    </a>
    <a class='delete' data-action='duplicateAutomation' data-tooltip='{{localize "DOCUMENT.Duplicate" type='Automation'}}'>
      {{localize 'Duplicate' type='Automation'}}
      <i class='fas fa-copy'></i>
    </a>

  </details>
  {{/each}}
</section>