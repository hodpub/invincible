<section class='tab boosts scrollable {{tab.cssClass}}' data-group='primary' data-tab='boosts'>
  {{!-- <div class="form-group">
    <label>
      <a class='boost-create' data-action='createBoost' data-origin="{{@root.item.uuid}}">
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='Boost'}}
      </a>
    </label>
  </div> --}}
  {{#each boosts as | boost index |}}

  <details data-boost-id="{{index}}" open>
    <summary>
      {{boost.name}}
    </summary>
    {{{boost.system.description}}}
    <a class='delete' data-action='updateBoost' data-uuid="{{boost.uuid}}" data-tooltip='{{localize "DOCUMENT.Update" type=' Boost'}}'>
      {{localize 'DOCUMENT.Update' type='Boost'}}
      <i class='fas fa-edit'></i>
    </a>
    <a class='delete' data-action='deleteBoost' data-uuid="{{boost.uuid}}" data-tooltip='{{localize "DOCUMENT.Delete" type=' Boost'}}'>
      {{localize 'DOCUMENT.Delete' type='Boost'}}
      <i class='fas fa-trash'></i>
    </a>
  </details>
  {{/each}}
</section>