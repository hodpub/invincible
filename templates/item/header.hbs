<header class='sheet-header'>
  <img
    class='profile-img'
    src='{{item.img}}'
    data-edit='img'
    data-action='onEditImage'
    data-tooltip='{{item.name}}'
  />
  <div class='header-fields'>
    <label class="title">{{localize (concat "TYPES.Item." item.type)}}</label>
    <div class='document-name'>
      <input name='name' type='text' value='{{item.name}}' placeholder='Name' data-tooltip-text="{{item.name}}" />
    </div>
  </div>
</header>