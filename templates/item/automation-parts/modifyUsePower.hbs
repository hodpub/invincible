<div>
  <div class="form-group">
    <label for="system.automations.{{automation._id}}.autoModify">{{localize
      "INVINCIBLE.Automation.FIELDS.modify.autoModify.label"}}</label>
    <input type="checkbox" name="system.automations.{{automation._id}}.autoModify" {{checked automation.autoModify}} />
  </div>
  <div class="tip">
    <label class="hint">{{localize "INVINCIBLE.Automation.FIELDS.modify.autoModify.hint"}}</label>
  </div>
  <div class="form-group">
    <label for="system.automations.{{key}}.stressCost">{{localize
      "INVINCIBLE.Automation.FIELDS.rollAttribute.stressCost.label"}}</label>
    <input type="text" name="system.automations.{{key}}.stressCost" value="{{automation.stressCost}}">
  </div>
</div>